# Doctor data source: osm (default, free, no key) | google | mock
EXPO_PUBLIC_DOCTOR_PROVIDER=osm
# Only needed when provider=google. Restrict the key to "Places API (New)".
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Supabase (Project Settings → API). The anon key is safe in the app; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
